# Copy this file to .env and fill in your keys.

# Required — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables real keyword volume + SERP data
# Sign up at https://dataforseo.com (~$0.06 per full analysis)
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=yourpassword

# Optional — enables Census ACS city score refresh button
# Free key (5 min): https://api.census.gov/sign-up
CENSUS_API_KEY=

# PORT=3000
