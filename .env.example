# Copy this file to .env and fill in your keys.
# The .env file is never committed to source control.

# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — enables real keyword volume + SERP data
# Requires Ahrefs API subscription (Advanced plan or dedicated API access)
# Get from https://ahrefs.com/api
AHREFS_API_KEY=

# Optional — override default port
# PORT=3000
